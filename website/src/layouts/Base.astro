---
import "../styles/site.css";

import Rail from "../components/Rail.astro";
import { withBase } from "../docs/content";
import { type Lang, T } from "../docs/i18n";
import { MASKS } from "../render/pixel";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Page key for the rail highlight, "home" or "404". */
  current: string;
  /** Same page in the other language. */
  alternate: { lang: Lang; href: string };
}

const { lang, title, description, current, alternate } = Astro.props;
const s = T[lang];
const fullTitle = current === "home" ? `Telegrinder · ${s.tagline}` : `${title} · Telegrinder`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const masks = `--mask-strands:${MASKS.strands};--mask-rule:${MASKS.rule};--mask-dither:url("data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="4" height="4" shape-rendering="crispEdges"><rect width="2" height="2"/><rect x="2" y="2" width="2" height="2"/></svg>')}")`;
---

<!doctype html>
<html lang={lang} style={masks}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" hreflang={lang} href={Astro.url.pathname} />
    <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0f" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={withBase("img/mark.webp")} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const theme = localStorage.getItem("telegrinder-docs:theme");
          if (theme === "light" || theme === "dark") root.setAttribute("data-theme", theme);
          if (theme === "onebit") root.setAttribute("data-onebit", "");
          if (sessionStorage.getItem("telegrinder-docs:arrive")) {
            sessionStorage.removeItem("telegrinder-docs:arrive");
            root.classList.add("is-arriving");
          }
        } catch {
          /* storage blocked: default theme, no transition */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{s.skip}</a>
    <div class="site">
      <Rail lang={lang} current={current} alternate={alternate} />
      <main class="main" id="content" data-lang={lang}>
        <slot />
      </main>
    </div>
    <div class="cover" aria-hidden="true"></div>
    <canvas class="dissolve" aria-hidden="true"></canvas>
    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
