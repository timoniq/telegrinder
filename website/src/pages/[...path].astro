---
import Chat from "../components/Chat.astro";
import { href, pages, readingOrder } from "../docs/content";
import { LANGS, type Lang, T } from "../docs/i18n";
import Base from "../layouts/Base.astro";
import { glassIcon, iconFor } from "../render/glass";
import { renderMarkdown } from "../render/markdown";
import { scenes as en } from "../scenes/en";
import { scenes as ru } from "../scenes/ru";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    pages(lang).map((p) => ({
      params: { path: (lang === "ru" ? "ru/" : "") + p.route.replace(/\/$/, "") },
      props: { lang, key: p.key },
    })),
  );
}

interface Props {
  lang: Lang;
  key: string;
}

const { lang, key } = Astro.props;
const s = T[lang];
const page = pages(lang).find((p) => p.key === key)!;
const other: Lang = lang === "ru" ? "en" : "ru";
const otherPage = pages(other).find((p) => p.key === key);
const scenes = (lang === "ru" ? ru : en)[key];
const rendered = renderMarkdown(page.markdown, { lang, file: page.file, strings: s, scenes });

const order = readingOrder(lang);
const at = order.findIndex((p) => p.key === key);
const prev = at > 0 ? order[at - 1] : undefined;
const next = at >= 0 && at < order.length - 1 ? order[at + 1] : undefined;

const numeral = page.number !== null ? String(page.number).padStart(2, "0") : page.section === "tools" ? "TL" : "RF";
const facts = [
  page.number !== null ? [s.chapter, `${page.number} / 12`] : [s.section, page.section === "tools" ? s.tools : s.reference],
  [s.time, `${page.minutes} ${s.min}`],
  [s.code, String(page.codeCount)],
  ...(page.contentLang !== lang ? [[s.lang, s.englishOnly]] : []),
];
---

<Base
  lang={lang}
  title={page.title}
  description={page.lead}
  current={key}
  alternate={{ lang: other, href: href(other, (otherPage ?? page).route) }}
>
  <div class:list={["doc", { "with-chat": Boolean(scenes) }]}>
    <article class="doc-body" lang={page.contentLang}>
      <header class="doc-head">
        <div class="doc-marks">
          <Fragment set:html={glassIcon(iconFor(key), "128px", "arrive", "pixel", "doc-icon")} />
          <span class="doc-num" aria-hidden="true">{numeral}</span>
        </div>
        <h1>{page.title}</h1>
        <dl class="facts">
          {
            facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>
      </header>
      <div class="prose" set:html={rendered.html} />
      {
        (prev || next) && (
          <nav class="pager" aria-label={`${s.prev} / ${s.next}`}>
            {prev && (
              <a class="prev" href={href(lang, prev.route)} data-gp-host>
                <Fragment set:html={glassIcon(iconFor(prev.key), "40px")} />
                <span class="pager-text"><small>{s.prev}</small><span>{prev.short}</span></span>
              </a>
            )}
            {next && (
              <a class="next" href={href(lang, next.route)} data-gp-host>
                <span class="pager-text"><small>{s.next}</small><span>{next.short}</span></span>
                <Fragment set:html={glassIcon(iconFor(next.key), "40px")} />
              </a>
            )}
          </nav>
        )
      }
    </article>
    {scenes && <Chat lang={lang} scenes={scenes} />}
  </div>
</Base>
