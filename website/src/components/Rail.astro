---
import { href, pages } from "../docs/content";
import { type Lang, T } from "../docs/i18n";
import { iconFor, pixelIcon } from "../render/glass";
import { markSvg } from "../render/pixel";

interface Props {
  lang: Lang;
  current: string;
  alternate: { lang: Lang; href: string };
}

const { lang, current, alternate } = Astro.props;
const s = T[lang];
const all = pages(lang).filter((p) => p.inNav);
const groups = [
  { name: s.tutorial, items: all.filter((p) => p.section === "tutorial") },
  { name: s.tools, items: all.filter((p) => p.section === "tools") },
  { name: s.reference, items: all.filter((p) => p.section === "reference") },
];
const isCurrent = (key: string) => current === key || (key === "changelog/index" && current.startsWith("changelog/"));
const langHref = (target: Lang) => (target === lang ? href(lang, "") : alternate.href);
const themes = ["auto", "light", "dark", "onebit"] as const;
---

<aside class="rail">
  <a class="brand" href={href(lang, "")} aria-label="Telegrinder">
    <Fragment set:html={markSvg()} />
    <span>telegrinder</span>
  </a>
  <nav class="nav" aria-label={s.tutorial}>
    {
      groups.map((group) => (
        <>
          <p class="nav-cap">{group.name}</p>
          {group.items.map((p) => (
            <a class="nav-item" href={href(lang, p.route)} aria-current={isCurrent(p.key) ? "page" : undefined}>
              <span class="n">{p.number !== null ? String(p.number).padStart(2, "0") : <Fragment set:html={pixelIcon(iconFor(p.key))} />}</span>
              <span class="t">{p.short}</span>
            </a>
          ))}
        </>
      ))
    }
  </nav>
  <div class="rail-foot">
    <div class="cells" role="group" aria-label={s.lang}>
      <a class="cell" href={langHref("en")} hreflang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
      <a class="cell" href={langHref("ru")} hreflang="ru" aria-current={lang === "ru" ? "true" : undefined}>RU</a>
      <a class="cell" href="https://github.com/timoniq/telegrinder" target="_blank" rel="noopener">{s.github}</a>
      <a class="cell" href="https://t.me/botoforum" target="_blank" rel="noopener">{s.forum}</a>
    </div>
    <div class="cells" role="group" aria-label={s.themeLabel}>
      {
        themes.map((t) => (
          <button class="cell theme-cell" type="button" data-theme-choice={t} aria-pressed="false">
            {s.themes[t]}
          </button>
        ))
      }
    </div>
  </div>
</aside>
